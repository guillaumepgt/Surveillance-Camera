# ==========================================
# Configuration de la caméra
# ==========================================
# 0 pour webcam USB intégrée, ou URL RTSP (ex: rtsp://192.168.1.50:554/stream)
CAMERA_SOURCE=0
FRAME_WIDTH=640
FRAME_HEIGHT=480
TARGET_FPS=20

# ==========================================
# Durées d'enregistrement (en secondes)
# 60s avant + 60s après = 120s (2 minutes)
# ==========================================
PRE_BUFFER_SECONDS=60.0
POST_BUFFER_SECONDS=60.0

# Compression JPEG en mémoire tampon (qualité 1-100, 85 recommandé ~50Mo en RAM)
JPEG_QUALITY=85

# ==========================================
# Détection de mouvement
# ==========================================
# Surface minimale de mouvement en pixels pour déclencher (augmenter si trop sensible)
MOTION_MIN_AREA=3500
# Sensibilité du filtre d'arrière-plan (plus bas = plus sensible)
MOTION_VAR_THRESHOLD=25
# Nombre d'images consécutives avec mouvement pour confirmer (~0.4s)
MOTION_CONSECUTIVE_FRAMES=8
# Délai de repos après un enregistrement avant réarmement (en secondes)
COOLDOWN_SECONDS=30.0
# Temps d'attente initial (en secondes) pour stabiliser la caméra avant de déclencher
MOTION_WARMUP_SECONDS=5.0
# Seuil de variation globale de luminosité (0.50 = si plus de 50% de l'image change d'un coup, ignoré)
MAX_MOTION_RATIO=0.50
LIGHTING_DELTA_THRESHOLD=12.0

# ==========================================
# Stockage local et affichage
# ==========================================
RECORDINGS_DIR=recordings
KEEP_LOCAL_COPY=true
ADD_OVERLAY=true

# ==========================================
# Envoi vers Google Drive
# Méthode: 'gdrive_api', 'rclone', ou 'none'
# ==========================================
UPLOAD_METHOD=gdrive_api

# Nom du dossier sur Google Drive (créé automatiquement s'il n'existe pas)
GDRIVE_FOLDER_NAME=Surveillance_Videos
# Optionnel : ID du dossier Google Drive spécifique
GDRIVE_FOLDER_ID=

# Fichiers d'authentification Google OAuth2
CREDENTIALS_FILE=credentials.json
TOKEN_FILE=token.json

# Si utilisation de Rclone (UPLOAD_METHOD=rclone)
RCLONE_REMOTE=gdrive:Surveillance

# ==========================================
# Alertes par Email (Optionnel)
# ==========================================
# Activez l'envoi d'un email avec capture photo et lien Google Drive à chaque mouvement :
ENABLE_EMAIL_ALERTS=true
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
# Votre adresse Gmail expéditrice
SMTP_USER=guillaume.prigent44@gmail.com
# Mot de passe d'application Gmail (16 caractères) généré sur https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
# Destinataire des alertes (votre email)
EMAIL_TO=guillaume.prigent44@gmail.com
